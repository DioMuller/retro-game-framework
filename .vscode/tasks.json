{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Gameboy",
            "type": "process",
            "command": "make",
            "args": [
                "gb"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "clear": true
            },
        },
        {
            "label": "Build Gameboy Color",
            "type": "process",
            "command": "make",
            "args": [
                "gbc"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "clear": true
            }           
        },
        {
            "label": "Build All",
            "type": "process",
            "command": "make",
            "args": [
                "all"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "clear": true
            }           
        },
        {
            "label": "Clean Build",
            "type": "process",
            "command": "make",
            "args": [
                "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "presentation": {
                "reveal": "always",
                "clear": true
